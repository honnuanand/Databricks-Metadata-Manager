# Application
APP_NAME="Databricks Metadata Manager"
APP_VERSION="1.0.0"
DEBUG=true

# Database (not used in our clean architecture - we use Databricks directly)
DATABASE_URL="postgresql://user:pass@localhost/dbname"

# Security
SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS  
CORS_ORIGINS=http://localhost:4001,http://localhost:3000,http://localhost:5173

# Databricks (these are handled in our databricks_client.py)
DATABRICKS_HOST="https://e2-demo-field-eng.cloud.databricks.com"
DATABRICKS_TOKEN=""

# Redis (not used in our clean architecture)
REDIS_URL="redis://localhost:6379/0"