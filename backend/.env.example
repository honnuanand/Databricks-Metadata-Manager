# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Option 1: Databricks Lakebase (recommended for production)
# Set these variables to use Lakebase as your database
LAKEBASE_HOST=your-instance.lakebase.cloud.databricks.com
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=postgres
LAKEBASE_USER=metadata_manager_app
LAKEBASE_PASSWORD=your-lakebase-password

# Option 2: Legacy DATABASE_URL (for Neon PostgreSQL or local development)
# If LAKEBASE_HOST is not set, this URL will be used
# DATABASE_URL=postgresql://user:password@localhost/metadata_manager

# Redis (for caching, optional)
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# SECURITY
# ============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# DATABRICKS
# ============================================================================
DATABRICKS_HOST=https://your-workspace.databricks.com
DATABRICKS_TOKEN=your-databricks-token
# Or use Service Principal
DATABRICKS_CLIENT_ID=your-client-id
DATABRICKS_CLIENT_SECRET=your-client-secret

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=Databricks Metadata Manager
APP_VERSION=1.0.0
DEBUG=True
CORS_ORIGINS=http://localhost:4001,http://localhost:5001

# ============================================================================
# EMAIL (optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password