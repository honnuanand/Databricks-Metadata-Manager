)

# Get the directory where this file is located
BASE_DIR = Path(__file__).resolve().parent.parent
STATIC_DIR = BASE_DIR / "static"

# Mount static files if the directory exists
if STATIC_DIR.exists():
    app.mount("/assets", StaticFiles(directory=str(STATIC_DIR / "assets")), name="assets")
    logger.info(f"Mounted static files from {STATIC_DIR}")
else:
    logger.warning(f"Static directory not found at {STATIC_DIR}")

# Include routers
app.include_router(auth.router, prefix="/api/v1/auth", tags=["Authentication"])
app.include_router(catalogs.router, prefix="/api/v1/catalogs", tags=["Catalogs"])

# Add users endpoint for frontend compatibility  
@app.get("/api/v1/users/me")
async def get_current_user_info_compat(current_user: User = Depends(get_current_active_user)):
    """Get current user information - compatibility endpoint"""
    from app.services.user_service import user_service
    
    try:
        permissions = await user_service.get_user_permissions(current_user)
        
        return {
            "id": current_user.user_id,
            "email": current_user.email,
            "username": current_user.username,
            "full_name": current_user.full_name,
            "role": current_user.role,
            "is_active": current_user.is_active,
            "permissions": permissions
        }
    except Exception as e:
        logger.error(f"Error getting user info: {e}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail="Internal server error"
        )

# Add comments endpoints
@app.get("/api/v1/comments")
async def list_catalogs():
    """List available catalogs"""
    from app.services.catalog_service import catalog_service
    try:
        # For now, use a default user ID until we implement proper authentication
        user_id = "system_user"
        catalogs = await catalog_service.list_accessible_catalogs(user_id)
        
        # Convert to the format expected by the frontend
        return [
            {
                "name": catalog.name,
                "comment": catalog.comment,
                "schemas_count": 0,  # Could be calculated if needed
                "last_updated": catalog.updated_at or catalog.created_at
            }
            for catalog in catalogs
        ]
    except Exception as e:
        logger.error(f"Error listing catalogs: {e}")
        # Fallback to mock data if Databricks is not available
        return [
            {
                "name": "arao",
                "comment": "Main catalog for Anand Rao's workspace",
                "schemas_count": 2,
                "last_updated": "2025-09-10T20:00:00Z"
            }
        ]

@app.get("/api/v1/catalogs/{catalog}/schemas")
async def list_schemas(catalog: str):
    """List schemas in a catalog"""
    from app.services.catalog_service import catalog_service
    try:
        user_id = "system_user"
        schemas = await catalog_service.list_schemas_in_catalog(catalog, user_id)
        
        # Convert to the format expected by the frontend
        return [
            {
                "name": schema.name,
                "catalog_name": schema.catalog_name,
                "comment": schema.comment,
                "tables_count": 0,  # Could be calculated if needed
                "last_updated": schema.updated_at or schema.created_at
            }
            for schema in schemas
        ]
    except Exception as e:
        logger.error(f"Error listing schemas for catalog {catalog}: {e}")
        # Fallback to mock data if Databricks is not available
        if catalog == "arao":
            return [
                {
                    "name": "metadata_manager",
                    "catalog_name": catalog,
                    "comment": "Central repository for Databricks metadata management",
                    "tables_count": 4,
                    "last_updated": "2025-09-10T20:00:00Z"
                },
                {
                    "name": "metadata_test",
                    "catalog_name": catalog,
                    "comment": "Test schema with sample tables and comprehensive metadata",
                    "tables_count": 8,
                    "last_updated": "2025-09-10T20:30:00Z"
                }
            ]
        return []

@app.get("/api/v1/catalogs/{catalog}/{schema}/tables")
async def list_tables(catalog: str, schema: str):
    """List tables in a schema"""
    from app.services.catalog_service import catalog_service
    try:
        user_id = "system_user"
        tables = await catalog_service.list_tables_in_schema(catalog, schema, user_id)
        
        # Convert to the format expected by the frontend
        return [
            {
                "name": table.name,
                "catalog_name": table.catalog_name,
                "schema_name": table.schema_name,
                "comment": table.comment,
                "column_count": 0,  # Could get actual count by querying columns
                "table_type": table.table_type,
                "last_updated": table.updated_at or table.created_at
            }
            for table in tables
        ]
    except Exception as e:
        logger.error(f"Error listing tables for {catalog}.{schema}: {e}")
        # Fallback to mock data if Databricks is not available
        if catalog == "arao" and schema == "metadata_test":
            return [
                {
                    "name": "users",
                    "catalog_name": catalog,
                    "schema_name": schema,
                    "comment": "Customer information and profile data",
                    "column_count": 15,
                    "table_type": "MANAGED",
                    "last_updated": "2025-09-10T20:30:00Z"
                },
                {
                    "name": "products", 
                    "catalog_name": catalog,
                    "schema_name": schema,
                    "comment": "Product catalog with detailed item specifications and inventory",
                    "column_count": 18,
                    "table_type": "MANAGED",
                    "last_updated": "2025-09-10T20:30:00Z"
                },
                {
                    "name": "orders",
                    "catalog_name": catalog,
                    "schema_name": schema,
                    "comment": "Customer orders with payment and shipping details", 
                    "column_count": 16,
                    "table_type": "MANAGED",
                    "last_updated": "2025-09-10T20:30:00Z"
                }
            ]
        elif catalog == "arao" and schema == "metadata_manager":
            return [
                {
                    "name": "users",
                    "catalog_name": catalog,
                    "schema_name": schema,
                    "comment": "System users with role-based access for metadata management",
                    "column_count": 8,
                    "table_type": "MANAGED",
                    "last_updated": "2025-09-10T19:00:00Z"
                }
            ]
        return []

@app.get("/api/v1/catalogs/{catalog}/{schema}/{table}/columns")
async def list_table_columns(catalog: str, schema: str, table: str):
    """List columns in a table with comprehensive metadata"""
    from app.services.catalog_service import catalog_service
    try:
        user_id = "system_user"
        columns = await catalog_service.get_table_columns(catalog, schema, table, user_id)
        
        # Convert to the format expected by the frontend
        return [
            {
                "name": column.name,
                "data_type": column.data_type,
                "comment": column.comment,
                "nullable": column.nullable,
                "position": column.position,
                "precision": None,  # Could be extracted from data_type if needed
                "scale": None,      # Could be extracted from data_type if needed
                "max_length": None, # Could be extracted from data_type if needed
                "default_value": None,
                "is_partition_key": column.partition_index is not None,
                "is_primary_key": False  # Would need additional logic to determine
            }
            for column in columns
        ]
    except Exception as e:
        logger.error(f"Error getting columns for {catalog}.{schema}.{table}: {e}")
        # Fallback to mock data if Databricks is not available
        if catalog == "arao" and schema == "metadata_test" and table == "users":
