# Metadata Manager Installation Configuration
# Copy this file to install_config.yaml and fill in your values
# Generated by: python install.py --init-config

version: "1.0"

# ============================================================================
# DATABRICKS CONFIGURATION
# ============================================================================
databricks:
  # Databricks workspace URL (required)
  # Example: https://your-workspace.cloud.databricks.com
  host: ""

  # SQL Warehouse ID for executing DDL statements (required)
  # Find this in Databricks UI: SQL > SQL Warehouses > [warehouse] > Connection Details
  # Example: 00887ae543d50e2a
  warehouse_id: ""

  # PAT Token - leave empty to be prompted securely
  # Or set DATABRICKS_TOKEN environment variable
  # token: ""

# ============================================================================
# UNITY CATALOG CONFIGURATION
# ============================================================================
catalog:
  # Catalog name where schemas will be created
  name: "arao"

  # Schema names
  schemas:
    primary: "metadata_manager"    # Main application schema
    test: "metadata_test"          # Test data schema for demos

  # Whether to create the test schema with sample e-commerce data
  create_test_schema: true

# ============================================================================
# SERVICE PRINCIPAL CONFIGURATION
# ============================================================================
service_principal:
  # Name of the service principal that will run the app
  # This is used in GRANT statements
  # After deployment, run SELECT current_user() from the app to find actual name
  name: "metadata-manager"

# ============================================================================
# SECRET SCOPE CONFIGURATION
# ============================================================================
secrets:
  # Name of the Databricks secret scope to create/use
  scope_name: "metadata-manager-secrets"

# ============================================================================
# NEON POSTGRESQL CONFIGURATION
# ============================================================================
database:
  # PostgreSQL connection URL - leave empty to be prompted securely
  # Or set DATABASE_URL environment variable
  # Format: postgresql://user:password@host/database?sslmode=require
  # url: ""

  # Run Alembic database migrations
  run_migrations: true

  # Seed initial users (admin, approver, test user)
  seed_data: true

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
deployment:
  # Databricks App name
  app_name: "metadata-manager"

  # Workspace path for deployment (auto-detected from user email if empty)
  # Example: /Workspace/Users/your.email@company.com/metadata-manager
  workspace_path: ""

# ============================================================================
# INSTALLATION OPTIONS
# ============================================================================
options:
  # Skip objects that already exist (recommended for idempotent installs)
  skip_existing: true

  # Verify existing objects match expected schema
  verify_structure: true

  # Prompt for missing values interactively
  interactive: true

  # Show detailed output during installation
  verbose: false
